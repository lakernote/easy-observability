<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.lakernote</groupId>
    <artifactId>easy-observability</artifactId>
    <version>0.1.0-alpha.0</version>
    <packaging>pom</packaging>
    <name>Easy Observability</name>
    <description>Spring Boot Trace and slow/error diagnostics</description>
    <url>https://github.com/lakernote/easy-observability</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>lakernote</id>
            <name>lakernote</name>
            <url>https://github.com/lakernote</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/lakernote/easy-observability.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/lakernote/easy-observability.git</developerConnection>
        <url>https://github.com/lakernote/easy-observability</url>
    </scm>
    <modules>
        <module>easy-observability-spring-boot-common</module>
        <module>easy-observability-spring-boot-3-autoconfigure</module>
        <module>easy-observability-spring-boot-3-starter</module>
        <module>easy-observability-spring-boot-4-autoconfigure</module>
        <module>easy-observability-spring-boot-4-starter</module>
        <module>examples/easy-observability-example-spring-boot-3</module>
        <module>examples/easy-observability-example-spring-boot-4</module>
    </modules>
    <properties>
        <java.version>17</java.version>
        <spring-boot-3.version>3.5.16</spring-boot-3.version>
        <spring-boot-4.version>4.1.1</spring-boot-4.version>
        <openfeign.version>13.6.1</openfeign.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <central.skipUpload>false</central.skipUpload>
    </properties>
    <profiles>
        <profile>
            <id>central-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                            <skipUpload>${central.skipUpload}</skipUpload>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
